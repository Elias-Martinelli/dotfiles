{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(uv run pytest *)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv add *)",
      "Bash(uv sync *)",
      "Bash(ruff *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.claude.json)",
      "Bash(rm -rf /*)"
    ]
  },
  "autoUpdatesChannel": "latest",
  "cleanupPeriodDays": 60,
  "env": {}
}
