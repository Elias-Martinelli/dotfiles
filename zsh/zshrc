# ~/.zshrc – wird von install.sh nach ~/.zshrc verlinkt (Quelle: zsh/zshrc im dotfiles-Repo).
# Läuft bei jeder interaktiven zsh-Sitzung (Windows Terminal, VS-Code-Terminal, Claude Code).
# Maschinenspezifisches (Keys, Proxys, private Aliasse) gehört in ~/.zshrc.local – sie wird ganz am Ende geladen.
# Reihenfolge ist wichtig: PATH -> oh-my-zsh -> History/Sprache -> Werkzeuge -> WSL -> Funktionen -> Aliasse -> lokal.

# ---------------------------------------------------------------------------
# PATH-Grundlagen
# ---------------------------------------------------------------------------
# Doppelte PATH-Einträge automatisch entfernen (zsh hält PATH und das Array path synchron).
typeset -U PATH path

# ~/.local/bin: hier landen uv, ruff (uv tool), claude und codex.
# Ersetzt das alte `. "$HOME/.local/bin/env"`, das der uv-Installer anhängt.
export PATH="$HOME/.local/bin:$PATH"

# ---------------------------------------------------------------------------
# oh-my-zsh: Theme, Plugins, Einstellungen (müssen VOR dem Laden gesetzt sein)
# ---------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# Plugins: git-Kürzel (gst, gco, gp, ...), schnelle git-Completion, letztes Verzeichnis merken,
# gängige Aliasse, graue Vorschläge aus der History, farbige Syntax, Suche mit Pfeil-hoch, SSH-Agent.
# Reihenfolge: zsh-autosuggestions muss vor zsh-syntax-highlighting stehen.
plugins=(git gitfast last-working-dir common-aliases zsh-autosuggestions zsh-syntax-highlighting history-substring-search ssh-agent)

# Keine Warnung wegen „insecure directories" bei der Completion (unter WSL sonst häufig).
ZSH_DISABLE_COMPFIX=true

# Autosuggestions: zuerst aus der History, dann aus der Tab-Vervollständigung vorschlagen.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# ssh-agent: Schlüssel erst beim ersten Gebrauch laden (zusammen mit `AddKeysToAgent yes` in ssh/config),
# sonst fragt jedes neue Terminal nach der Passphrase. quiet: keine Meldungen beim Start.
zstyle :omz:plugins:ssh-agent lazy yes
zstyle :omz:plugins:ssh-agent quiet yes

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  echo "⚠️  oh-my-zsh fehlt (~/.oh-my-zsh). Bitte ./install.sh aus dem dotfiles-Repo ausführen." >&2
fi

# Aliasse aus common-aliases zurücknehmen: rm ohne -i-Rückfrage, lt soll als Befehlsname frei bleiben.
# 2>/dev/null: kein Fehler, falls der Alias gar nicht gesetzt ist.
unalias rm 2>/dev/null
unalias lt 2>/dev/null

# ---------------------------------------------------------------------------
# History: 50'000 Einträge, keine Duplikate, zwischen offenen Terminals geteilt
# (nach oh-my-zsh setzen, weil oh-my-zsh eigene Vorgaben mitbringt)
# ---------------------------------------------------------------------------
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS   # ältere Duplikate eines Befehls aus der History entfernen
setopt HIST_IGNORE_SPACE      # Befehle mit führendem Leerzeichen nicht speichern (praktisch für Tokens)
setopt SHARE_HISTORY          # History sofort zwischen allen offenen Terminals teilen

# ---------------------------------------------------------------------------
# Sprache und Editor
# ---------------------------------------------------------------------------
# UTF-8 mit englischen Programm-Meldungen (Fehlermeldungen lassen sich so besser suchen).
# Fallback auf C.UTF-8, falls en_US.UTF-8 auf der Maschine nicht erzeugt wurde.
if locale -a 2>/dev/null | grep -qiE '^en_US\.utf-?8$'; then
  export LANG=en_US.UTF-8
  export LC_ALL=en_US.UTF-8
else
  export LANG=C.UTF-8
  export LC_ALL=C.UTF-8
fi

# Editor: VS Code. `--wait` lässt git, crontab & Co. warten, bis die Datei geschlossen ist. Ohne VS Code: vim.
if command -v code >/dev/null 2>&1; then
  export EDITOR="code --wait"
else
  export EDITOR="vim"
fi
export VISUAL="$EDITOR"

# ---------------------------------------------------------------------------
# Python: pyenv (Versionen), uv (Pakete/Projekte/Tools), ruff (Linter/Formatter), ipdb (Debugger)
# ---------------------------------------------------------------------------
# pyenv auch dann laden, wenn ~/.zprofile nicht gelesen wurde (z. B. VS-Code-Terminal): PATH hier selbst setzen.
export PYENV_ROOT="$HOME/.pyenv"
[[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"

# pyenv-virtualenv soll den Prompt nicht selbst umbauen; stattdessen zeigen wir die aktive Python-Version rechts an.
export PYENV_VIRTUALENV_DISABLE_PROMPT=1
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init - zsh)"
  eval "$(pyenv virtualenv-init - 2>/dev/null)"
  RPROMPT+='[🐍 $(pyenv version-name)]'
fi

# breakpoint() in Python öffnet ipdb statt pdb (im Projekt mit `uv add --dev ipdb` installieren).
export PYTHONBREAKPOINT=ipdb.set_trace

# Tab-Vervollständigung für uv und ruff – nur wenn installiert. Gleiches Vorgehen wie die oh-my-zsh-Plugins
# „uv" und „ruff": `<tool> generate-shell-completion zsh` wird als Datei in $ZSH_CACHE_DIR/completions abgelegt
# (dieser Ordner liegt im fpath) und bei jedem Start im Hintergrund erneuert. Ein `eval "$(uv generate-shell-completion zsh)"`
# bei jedem Start würde rund eine halbe Sekunde kosten.
_dotfiles_completion_cache() {
  local tool="$1" file="$ZSH_CACHE_DIR/completions/_$1"
  (( $+commands[$tool] )) || return 0
  [[ -d "$ZSH_CACHE_DIR/completions" ]] || return 0
  if [[ ! -f "$file" ]]; then
    # Erster Start: Funktion für diese Sitzung von Hand registrieren; ab dem nächsten Start erledigt das compinit.
    typeset -g -A _comps
    autoload -Uz "_$tool"
    _comps[$tool]="_$tool"
  fi
  zmodload -F zsh/files b:zf_mv
  () { local TMPPREFIX="$file"; zf_mv -f -- =( "$tool" generate-shell-completion zsh ) "$file"; } &|
}
_dotfiles_completion_cache uv
_dotfiles_completion_cache ruff

# ---------------------------------------------------------------------------
# Node.js via nvm – nur aktiv, wenn ~/.nvm existiert (install.sh, Schritt 7)
# ---------------------------------------------------------------------------
export NVM_DIR="$HOME/.nvm"
if [[ -d "$NVM_DIR" ]]; then
  [[ -s "$NVM_DIR/nvm.sh" ]] && \. "$NVM_DIR/nvm.sh"
  [[ -s "$NVM_DIR/bash_completion" ]] && \. "$NVM_DIR/bash_completion"

  # Beim Verzeichniswechsel automatisch `nvm use`, wenn im Projekt eine .nvmrc liegt.
  autoload -U add-zsh-hook
  load-nvmrc() {
    if nvm -v &>/dev/null; then
      local node_version nvmrc_path nvmrc_node_version
      node_version="$(nvm version)"
      nvmrc_path="$(nvm_find_nvmrc)"

      if [[ -n "$nvmrc_path" ]]; then
        nvmrc_node_version="$(nvm version "$(cat "${nvmrc_path}")")"

        if [[ "$nvmrc_node_version" == "N/A" ]]; then
          nvm install
        elif [[ "$nvmrc_node_version" != "$node_version" ]]; then
          nvm use --silent
        fi
      elif [[ "$node_version" != "$(nvm version default)" ]]; then
        nvm use default --silent
      fi
    fi
  }
  type nvm >/dev/null 2>&1 && add-zsh-hook chpwd load-nvmrc
  type nvm >/dev/null 2>&1 && load-nvmrc
fi

# ---------------------------------------------------------------------------
# direnv: lädt pro Projekt eine .envrc (Umgebungsvariablen, API-Keys) – nur wenn installiert (packages/apt.txt)
# ---------------------------------------------------------------------------
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# ---------------------------------------------------------------------------
# WSL-Komfort: Windows-Programme aus Ubuntu heraus (nur wenn erreichbar, d. h. appendWindowsPath=true)
# ---------------------------------------------------------------------------
command -v explorer.exe >/dev/null 2>&1 && alias open='explorer.exe'   # `open .` öffnet den Ordner im Windows-Explorer
command -v clip.exe >/dev/null 2>&1 && alias pbcopy='clip.exe'         # `cat datei | pbcopy` kopiert in die Windows-Zwischenablage

# Ubuntu nennt zwei Werkzeuge anders: fd-find -> fdfind, bat -> batcat. Alias nur, wenn das echte Programm fehlt.
# $+commands prüft ausschliesslich Programme im PATH – nötig, weil common-aliases selbst einen Alias `fd` definiert.
(( $+commands[fdfind] && ! $+commands[fd] )) && alias fd='fdfind'
(( $+commands[batcat] && ! $+commands[bat] )) && alias bat='batcat'

# ---------------------------------------------------------------------------
# update-all: alles auf einmal aktualisieren (apt, uv + uv-Tools, Claude Code, Codex CLI, oh-my-zsh)
# ---------------------------------------------------------------------------
_update_all_step() { printf '\n\033[1;34m==> %s\033[0m\n' "$1"; }

update-all() {
  _update_all_step "apt: Ubuntu-Pakete aktualisieren"
  sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get autoremove -y

  if command -v uv >/dev/null 2>&1; then
    _update_all_step "uv: uv selbst und alle uv-Tools (ruff, pre-commit, ...)"
    uv self update
    uv tool upgrade --all
  fi

  if command -v claude >/dev/null 2>&1; then
    _update_all_step "Claude Code"
    claude update
  fi

  if command -v codex >/dev/null 2>&1; then
    _update_all_step "Codex CLI (der Installer-Einzeiler aktualisiert auf die neueste Version)"
    # CODEX_NON_INTERACTIVE=1: sonst fragt der Installer am Ende «Start Codex now?» und wartet.
    curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh
  fi

  printf '\n✅ Fertig. Wenn oh-my-zsh gleich Änderungen findet, startet es die Shell automatisch neu.\n'

  # Zum Schluss, weil `omz update` die Shell bei Änderungen per exec neu startet – danach käme nichts mehr.
  if (( $+functions[omz] )); then
    _update_all_step "oh-my-zsh"
    omz update
  fi
}

# ---------------------------------------------------------------------------
# Eigene Aliasse (zsh/aliases -> ~/.aliases), danach Maschinenspezifisches (~/.zshrc.local, nicht im Repo)
# ---------------------------------------------------------------------------
if [[ -f "$HOME/.aliases" ]]; then
  source "$HOME/.aliases"
fi
if [[ -f "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
